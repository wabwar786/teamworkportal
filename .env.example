APP_NAME="Wabwar Vault"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://your-app.up.railway.app

# Public base URL that widget.js / WinForms clients hit (usually same as APP_URL)
CHAT_BASE_URL=https://your-app.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database ---
# Railway MySQL: it injects DB_URL (or MYSQL_URL). Laravel parses DB_URL directly.
# If you only have discrete vars, fill host/port/db/user/pass instead.
DB_CONNECTION=mysql
DB_URL=${MYSQL_URL}
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# CORS origins allowed to load the chat widget (comma separated, * for any)
CHAT_ALLOWED_ORIGINS=*
